@import "themes/current.rasi"

* {
    background-color: transparent;
    text-color: @text;

    font: "JetBrainsMono Nerd Font 12";
}

window {
    width: 540px;

    location: center;
    anchor: center;

    x-offset: -150px;

    background-color: @base;

    border: 2px;
    border-color: @surface1;
    border-radius: 16px;
}

mainbox {
    padding: 16px;
    spacing: 12px;

    background-color: transparent;
}

inputbar {
    padding: 10px 12px;
    spacing: 10px;

    background-color: @mantle;

    border-radius: 10px;

    children: [
        prompt,
        entry
    ];
}

prompt {
    background-color: transparent;
    text-color: @mauve;
}

entry {
    background-color: transparent;
    text-color: @text;

    placeholder: "Search...";
    placeholder-color: @overlay0;
}

listview {
    columns: 1;
    lines: 10;

    spacing: 5px;

    fixed-height: false;

    scrollbar: false;

    background-color: transparent;
}

element {
    padding: 10px 12px;

    background-color: transparent;
    text-color: @text;

    border-radius: 10px;
}

element normal.normal {
    background-color: transparent;
    text-color: @text;
}

element selected.normal {
    background-color: @surface0;
    text-color: @blue;
}

element alternate.normal {
    background-color: transparent;
    text-color: @text;
}

element-text {
    background-color: inherit;
    text-color: inherit;

    vertical-align: 0.5;
}

message {
    padding: 8px 10px;

    background-color: @mantle;

    border-radius: 8px;
}

textbox {
    background-color: transparent;
    text-color: @subtext0;
}
