@import "themes/current.rasi"

* {
    bg:         @base;
    bg-alt:     @surface0;
    fg:         @text;
    fg-muted:   @overlay1;

    accent:     @mauve;
    accent-fg:  @crust;

    border:     @surface1;
}

window {
    width: 900px;

    padding: 18px;

    background-color: @bg;

    border: 2px;
    border-color: @border;
    border-radius: 14px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 16px;
    background-color: transparent;
}

inputbar {
    children: [ entry ];

    margin: 0 140px;
    padding: 14px 18px;

    background-color: @surface0;

    border-radius: 14px;
}

entry {
    placeholder: "Search";
    placeholder-color: @overlay1;

    background-color: transparent;
    text-color: @text;

    horizontal-align: 0.5;
}

prompt {
    text-color: @accent;
    expand: false;
}

textbox-prompt-colon {
    enabled: false;
}

case-indicator,
num-filtered-rows,
num-rows,
textbox-num-sep,
message,
textbox-message,
scrollbar {
    enabled: false;
}

listview {
    columns: 2;
    lines: 5;
    spacing: 8px;

    background-color: @bg;
    scrollbar: false;

    dynamic: true;
    fixed-height: false;
}

element {
    orientation: horizontal;

    padding: 10px 12px;
    spacing: 10px;

    background-color: transparent;
    text-color: @fg;

    border-radius: 10px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: @fg;
}

element-icon {
    size: 22px;
    background-color: transparent;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
